B.bKc=new A.a0h(B.aDV,"\ud83d\udce4 Step 2: Update Payment Details","After payment, click the Update button next to the same item.\n\nIn the form:\n\u2022 Select the Payment Method (e.g., Link or Bank Transfer).\n\u2022 Enter the Paid Date (date of your transaction).\n\u2022 Upload the payment confirmation screenshot.\n\u2022 Fill in the Transaction ID (for bank transfers).",null)
